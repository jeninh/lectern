# Settings for deploy/tailscale/compose.yaml (guide: docs/deploy-tailscale.md).
#
#   cp .env.example .env && chmod 600 .env     # then edit .env, never this file
#   docker compose --env-file .env -f deploy/tailscale/compose.yaml up -d --build
#
# .env is git-ignored; it holds a secret. Values are plain text: no quotes, no spaces.

# --- Required -------------------------------------------------------------------------

# Exactly the address you will type in the browser: https://<TS_HOSTNAME>.<tailnet>.ts.net
# Your tailnet name is on https://login.tailscale.com/admin/dns. Passkeys are bound to it.
LECTERN_BASE_URL=https://lectern.tail1234.ts.net

# One-off auth key from https://login.tailscale.com/admin/settings/keys (not reusable, not
# ephemeral; pre-approved if device approval is on). Needed for the first start only; you
# can delete the value afterwards, the node keeps its identity in TS_STATE_PATH.
TS_AUTHKEY=

# --- Optional (defaults shown) --------------------------------------------------------

# Tailscale machine name; must match the first label of LECTERN_BASE_URL.
TS_HOSTNAME=lectern

# User and group Lectern runs as. They must own the data and library directories.
# `id -u` / `id -g` print yours; the first user on Raspberry Pi OS is 1000:1000.
LECTERN_UID=1000
LECTERN_GID=1000

# Where state lives on the host. Leave empty for the defaults inside the checkout
# (data/lectern, data/tailscale, library/). If you set them, use ABSOLUTE paths
# (e.g. /mnt/ssd/lectern/library): relative paths would resolve against deploy/tailscale/.
LECTERN_DATA_PATH=
LECTERN_LIBRARY_PATH=
TS_STATE_PATH=

# Backup target on the host, mounted at /backups (default: backups/ in the checkout).
# Backups are off until the owner turns them on in Admin → Backups. On a Raspberry Pi use a
# USB drive, not the SD card, e.g. /media/usb/lectern-backups (absolute, owned by
# LECTERN_UID:LECTERN_GID). See docs/backups.md.
LECTERN_BACKUP_PATH=

# Optional engines built into the image, space- or comma-separated. Empty builds the default
# slim image.
#   align  faster-whisper for aligning audiobooks (~0.6 GB, ~1.4 GB RAM per job)
#   tts    Piper for generated audiobooks
# On a Raspberry Pi 4/5 with at least 4 GB, LECTERN_EXTRAS="align tts" lets the Pi narrate
# with Piper and align (slowly) by itself; while the Mac worker is on it gets alignment jobs
# first. See docs/alignment.md#where-to-run-it-raspberry-pi-nas-laptop and docs/tts.md.
LECTERN_EXTRAS=

# Alignment model and CPU threads, used only when LECTERN_EXTRAS includes align. On a Pi use
# base and the core count (4); empty = small and CTranslate2's default.
LECTERN_ALIGN_MODEL=
LECTERN_ALIGN_THREADS=

# The commit being built, so Mac workers from /worker/install.sh install the same code.
# Leave empty here and pass it when building: LECTERN_COMMIT=$(git rev-parse HEAD) docker compose …
LECTERN_COMMIT=

LECTERN_LOG_LEVEL=INFO

# 1 = offline mode: Lectern makes no outbound internet connections, and Admin cannot turn it
# off. Download models first (Admin → Offline mode). See docs/offline-mode.md.
LECTERN_OFFLINE=

# Address KOReader e-readers use, put into each lectern.koplugin zip (docs/koreader-plugin.md).
# Empty = Lectern's own Tailscale IP on port 8080, found automatically. Set it only if that
# guess is wrong, e.g. LECTERN_DEVICE_URL=http://100.101.102.103:8080
LECTERN_DEVICE_URL=
