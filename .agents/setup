#!/usr/bin/env bash
# Amp orb setup: runs once per project snapshot (see https://ampcode.com/docs/orbs/customizing).
# Installs wakatime-cli and a Claude Code hook so orb work is reported to Hackatime
# (Hack Club's WakaTime-compatible time tracker). ~/.wakatime.cfg, which holds the API key,
# is written by .agents/resume instead, because setup never receives personal secrets
# and its result is saved in a snapshot shared with other orbs.
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)

# --- wakatime-cli -------------------------------------------------------------
WAKATIME_VERSION=v2.28.0
bin="$HOME/.local/bin/wakatime-cli"
if ! "$bin" --version 2>/dev/null | grep -qx "${WAKATIME_VERSION}"; then
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT
	base="https://github.com/wakatime/wakatime-cli/releases/download/${WAKATIME_VERSION}"
	curl -fsSL -o "$tmp/wakatime-cli-linux-amd64.zip" "$base/wakatime-cli-linux-amd64.zip"
	curl -fsSL -o "$tmp/checksums_sha256.txt" "$base/checksums_sha256.txt"
	(cd "$tmp" && grep ' wakatime-cli-linux-amd64.zip$' checksums_sha256.txt | sha256sum -c --quiet -)
	unzip -q -o "$tmp/wakatime-cli-linux-amd64.zip" -d "$tmp"
	install -D -m 0755 "$tmp/wakatime-cli-linux-amd64" "$bin"
fi

# --- Claude Code PostToolUse hook ---------------------------------------------
# Applies to Claude Code running inside the orb. Amp's Claude Code mode runs Claude Code
# outside the orb, so those threads are reported by .amp/plugins/hackatime.ts instead.
hook="$repo/.agents/hackatime-claude-hook"
settings="$HOME/.claude/settings.json"
mkdir -p "$(dirname "$settings")"
[ -s "$settings" ] || echo '{}' >"$settings"
jq --arg cmd "$hook" '
	.hooks.PostToolUse = (
		[(.hooks.PostToolUse // [])[] | select(all(.hooks[]?; .command != $cmd))]
		+ [{matcher: "*", hooks: [{type: "command", command: $cmd, timeout: 5}]}]
	)' "$settings" >"$settings.tmp"
mv "$settings.tmp" "$settings"
