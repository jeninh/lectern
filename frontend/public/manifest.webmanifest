{
  "id": "/app",
  "name": "Lectern",
  "short_name": "Lectern",
  "description": "Your household library: read, listen, and read along, online or offline.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "any",
  "background_color": "#f5efe4",
  "theme_color": "#f5efe4",
  "categories": ["books", "education"],
  "icons": [
    { "src": "/app/pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/app/pwa/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/app/pwa/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/app/pwa/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "/app/save-article",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Downloads", "url": "/app/downloads", "icons": [{ "src": "/app/pwa/icon-192.png", "sizes": "192x192" }] },
    { "name": "Listening", "url": "/app/listening", "icons": [{ "src": "/app/pwa/icon-192.png", "sizes": "192x192" }] }
  ]
}
